        "# Criar coluna grupo_uso\n",
        "def classificar_uso(col):\n",
        "    if col['quant_chamadas'] < 5 and col['quant_mensagens'] < 5:\n",
        "        return 'Baixo uso'\n",
        "    elif col['quant_chamadas'] < 10 and col['quant_mensagens'] < 10:\n",
        "        return 'Uso médio'\n",
        "    else:\n",
        "        return 'Alto uso'\n",
        "\n",
        "# Criar coluna grupo_uso aplicando a função em cada linha\n",
        "user_profile['grupo_uso'] = user_profile.apply(classificar_uso, axis=1)\n",
        "\n",
        "user_profile['grupo_uso'].value_counts()\n",
        "\n"
