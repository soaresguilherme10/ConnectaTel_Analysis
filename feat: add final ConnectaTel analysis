        "# Criar coluna grupo_idade\n",
        "def idade(col):\n",
        "  if col[\"age\"] < 30:\n",
        "    return 'Jovem'\n",
        "  elif col['age'] < 60:\n",
        "    return 'Adulto'\n",
        "  else:\n",
        "    return 'Idoso'\n",
        "\n",
        "#Criar coluna grupo_idade aplicando a função em cada linha\n",
        "user_profile['grupo_idade'] = user_profile.apply(idade, axis = 1)\n",
        "\n",
        "user_profile['grupo_idade'].value_counts()\n",
        "\n",
        "\n"
      ]
