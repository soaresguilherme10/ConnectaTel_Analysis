      "source": [
        "# Calcular limites com o método IQR\n",
        "colunas_limites = ['quant_mensagens', 'quant_chamadas', 'quant_minutos_chamada']\n",
        "\n",
        "for col in colunas_limites:\n",
        "    Q1 = user_profile[col].quantile(0.25)\n",
        "    Q3 = user_profile[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    limite_superior = Q3 + 1.5 * IQR\n",
        "    qtd_outliers = (user_profile[col] > limite_superior).sum()\n",
        "    pct_outliers = qtd_outliers / len(user_profile) * 100\n",
        "\n",
        "    print(f\"{col}: limite superior = {limite_superior:.2f} | \"\n",
        "          f\"outliers = {qtd_outliers} ({pct_outliers:.2f}%)\")\n",
        "\n",
